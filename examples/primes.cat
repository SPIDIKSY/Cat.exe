adopt math;

// Решето в линейной памяти VM: peek8/poke8
purr main() {
    yarn n: u32 = 50;
    yarn i: u32 = 2;
    chase i <= n {
        yarn j: u32 = i * i;
        sniff look8(i) == 0 {
            chase j <= n {
                bat8(j, 1);
                j = j + i;
            }
            meow(i);
        }
        i = i + 1;
    }
    meow(math.gcd(48, 18));
    meow(math.pow(2, 10));
    meow(math.isqrt(1000000));
}
