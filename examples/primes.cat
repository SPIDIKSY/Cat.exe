use math;

// Решето в линейной памяти VM: peek8/poke8
fn main() {
    let n: u32 = 50;
    let i: u32 = 2;
    while i <= n {
        let j: u32 = i * i;
        if peek8(i) == 0 {
            while j <= n {
                poke8(j, 1);
                j = j + i;
            }
            print(i);
        }
        i = i + 1;
    }
    print(math.gcd(48, 18));
    print(math.pow(2, 10));
    print(math.isqrt(1000000));
}
