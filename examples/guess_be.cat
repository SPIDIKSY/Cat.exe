#мова be
// Гульня «Адгадай лік» па-беларуску: кот загадаў лік ад 1 да 100, у цябе 7 спроб.
функцыя main() {
    няхай secret: i64 = выпадковы(100) як i64 + 1;
    няхай спробы: i64 = 7;
    друкуй("Мяў! Я загадаў лік ад 1 да 100. Адгадай!");
    для спроба у 1..спробы + 1 {
        пішы("Спроба ");
        пішы(спроба);
        пішы(" з ");
        пішы(спробы);
        пішы(": ");
        няхай здагадка: i64 = чытай_лік();
        калі мяў лік_уведзены() {
            друкуй("Гэта не лік, мяў. Спроба страчана.");
            працягнуць;
        }
        калі здагадка == secret {
            друкуй("Адгадаў! Ты сапраўдны кот!");
            вярнуць;
        }
        калі здагадка < secret { друкуй("Больш."); } інакш { друкуй("Менш."); }
    }
    пішы("Не адгадаў. Я загадаў: ");
    друкуй(secret);
}
