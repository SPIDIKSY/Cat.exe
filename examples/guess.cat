// Игра «Угадай число»: котик загадал число от 1 до 100, у тебя 7 попыток.
purr main() {
    yarn secret: i64 = roll(100) like i64 + 1;
    yarn tries: i64 = 7;
    meow("Мяу! Я загадал число от 1 до 100. Угадай!");
    prowl attempt among 1..tries + 1 {
        mew("Попытка ");
        mew(attempt);
        mew(" из ");
        mew(tries);
        mew(": ");
        yarn guess: i64 = ask();
        sniff T heard() {
            meow("Это не число, мяу. Попытка потеряна.");
            hop;
        }
        sniff guess == secret {
            meow("Угадал! Ты настоящий кот!");
            bring;
        }
        sniff guess < secret { meow("Больше."); } hiss { meow("Меньше."); }
    }
    mew("Не угадал. Я загадал: ");
    meow(secret);
}
