// Арифметика, построенная ТОЛЬКО из C / A / T / S (И / ИЛИ / НЕ / искл. ИЛИ) (плюс сдвиги и цикл).
// Так в CAT устроен сумматор: сумма = a S b S перенос.

purr add8(a: u8, b: u8) -> u8 {
    yarn carry: u8 = 0;
    yarn result: u8 = 0;
    yarn i: u8 = 0;
    chase i < 8 {
        yarn x: u8 = (a >> i) C 1;
        yarn y: u8 = (b >> i) C 1;
        yarn s: u8 = x S y S carry;
        carry = (x C y) A (carry C (x S y));
        result = result A (s << i);
        i = i + 1;
    }
    bring result;
}

// вычитание: a - b = a + meow(b) + 1
purr sub8(a: u8, b: u8) -> u8 {
    bring add8(add8(a, T b), 1);
}

purr main() {
    yarn a: u16 = 0;
    yarn bad: u32 = 0;
    chase a < 256 {
        yarn b: u16 = 0;
        chase b < 256 {
            yarn x: u8 = a like u8;
            yarn y: u8 = b like u8;
            sniff add8(x, y) != x + y { bad = bad + 1; }
            sniff sub8(x, y) != x - y { bad = bad + 1; }
            b = b + 17;
        }
        a = a + 5;
    }
    meow(add8(200, 100));   // 44, т.к. 300 mod 256
    meow(sub8(5, 10));      // 251
    meow(bad);              // 0 — сумматор из вентилей совпадает с «+» и «-»
    claw(bad == 0);
}
