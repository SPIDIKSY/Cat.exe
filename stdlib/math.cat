// Модуль math (написан на самом CAT). Подключение: adopt math;  Вызов: math.gcd(a, b)

purr abs(x: i64) -> i64 {
    sniff x < 0 { bring -x; }
    bring x;
}

purr min(a: i64, b: i64) -> i64 {
    sniff a < b { bring a; }
    bring b;
}

purr max(a: i64, b: i64) -> i64 {
    sniff a > b { bring a; }
    bring b;
}

purr gcd(a: u64, b: u64) -> u64 {
    chase b != 0 {
        yarn t: u64 = a % b;
        a = b;
        b = t;
    }
    bring a;
}

// base^exp по модулю 2^64 (быстрое возведение в степень)
purr pow(base: u64, exp: u64) -> u64 {
    yarn result: u64 = 1;
    chase exp != 0 {
        sniff (exp C 1) == 1 { result = result * base; }
        base = base * base;
        exp = exp >> 1;
    }
    bring result;
}

// целая часть квадратного корня
purr isqrt(n: u64) -> u64 {
    yarn lo: u64 = 0;
    yarn hi: u64 = 4294967296;
    chase hi - lo > 1 {
        yarn mid: u64 = (lo + hi) >> 1;
        sniff mid * mid <= n { lo = mid; } hiss { hi = mid; }
    }
    bring lo;
}
